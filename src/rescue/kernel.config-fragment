# PaOS Rescue Environment: small bare-metal recovery kernel, no modules.
CONFIG_64BIT=y
# Modern firmware may enter with x2APIC already enabled. Keep real interrupt
# remapping backends, not just the hypervisor-only X2APIC dependency shortcut.
CONFIG_SMP=y
CONFIG_NR_CPUS=256
CONFIG_NUMA=y
CONFIG_X86_64_ACPI_NUMA=y
CONFIG_AMD_NUMA=y
CONFIG_ACPI_HMAT=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_IRQ_REMAP=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y
CONFIG_X86_X2APIC=y
# PAT requires MTRR; uncached EFI framebuffer writes can stall early boot.
CONFIG_MTRR=y
CONFIG_X86_PAT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_X86_MCE=y
CONFIG_X86_MCE_INTEL=y
CONFIG_X86_MCE_AMD=y
CONFIG_CPU_MITIGATIONS=y
CONFIG_X86_UMIP=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=n
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_EFI_SOFT_RESERVE=y
CONFIG_EFI_RUNTIME_MAP=y
CONFIG_ACPI=y
CONFIG_DMI=y
CONFIG_DMIID=y
CONFIG_DMI_SYSFS=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEAER=y
CONFIG_VMD=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y

CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_EARLY_PRINTK=y
# Keep local boot evidence when no serial receiver, USB log or NIC is available.
CONFIG_EFI_EARLYCON=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y

CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
# The stage-log writer serialises its per-boot write budget with flock(2); without this every
# flock fails with ENOSYS and the writer refuses 'budget' (rc-qemu 22:10:30).
CONFIG_FILE_LOCKING=y
CONFIG_SYSFS=y
# EFI panic/oops snapshots after backend registration (10 KiB of kernel text).
# Not a continuous console or a record of failures before EFI/pstore init.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_DEFAULT_KMSG_BYTES=10240
CONFIG_EFI_VARS_PSTORE=y
CONFIG_EFI_VARS_PSTORE_DEFAULT_DISABLE=n
# Use genuine bounded/reclaimable tmpfs rather than the old ramfs fallback.
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

CONFIG_BLOCK=y
# Rescue must discover an ESP on QEMU virtio PCI disks before modules or a root filesystem exist.
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000E=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
# MSI MS-7E19 Killer E5000B (RTL8126A family): r8169 loads these at open; built in, no root filesystem.
CONFIG_FW_LOADER=y
CONFIG_EXTRA_FIRMWARE="rtl_nic/rtl8126a-2.fw rtl_nic/rtl8126a-3.fw"
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y

CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_HID=y
# USB sticks (the stage-log B volume, owner media) are SCSI disks behind usb-storage or UAS;
# with modules off they must be built in, or Rescue sees only the boot disk.
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# Keep the independent recovery base small and deterministic.
CONFIG_MODULES=n
CONFIG_KEXEC=n
CONFIG_HIBERNATION=n
CONFIG_SOUND=n
CONFIG_WLAN=n
CONFIG_BT=n
CONFIG_DRM=n
