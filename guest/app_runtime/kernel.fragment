# Apply to the maintained Linux source/config; resolve and retain actual config.
# Runtime isolation belongs to the native separate app VM, not this fragment.
CONFIG_64BIT=y
CONFIG_X86_IOPL_IOPERM=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_TTY=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
# Existing profile compiler capabilities; app init uses ttyS0, no MMIO probing.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_PHYSICAL_START=0x1000000
CONFIG_EFI_STUB=n
CONFIG_RELOCATABLE=n
CONFIG_RANDOMIZE_BASE=n

# Local chat adapter seals anonymous input before invoking the existing supervisor.
CONFIG_MEMFD_CREATE=y
CONFIG_SHMEM=y
