# Add to the FULL maintained x86_64 Linux distribution/driver config.
# Never apply to tinyconfig; never use a learned hardware/module allowlist.
CONFIG_64BIT=y
# The bounded paos WAIT CLI requests only its dedicated PIO ports.
CONFIG_X86_IOPL_IOPERM=y
CONFIG_SMP=n
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_TTY=y
CONFIG_HVC_DRIVER=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_NET=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_BRIDGE=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FW_LOADER=y
# Preserve the FULL config's broad built-in/module drivers and firmware set.
# Fixed direct-boot load convention; the native loader owns actual fit.
CONFIG_PHYSICAL_START=0x1000000
# EFI_STUB selects RELOCATABLE in a full distribution config.
# This guest enters through the native Linux direct-load path.
CONFIG_EFI_STUB=n
CONFIG_RELOCATABLE=n
CONFIG_RANDOMIZE_BASE=n
